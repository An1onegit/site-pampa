---
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/routes';
interface Props { locale: Locale; }
const { locale } = Astro.props;
const t = useTranslations(locale);
const g = t.gallery;
const eyebrow = locale === 'fr' ? 'En images' : 'In pictures';
const hint = locale === 'fr' ? 'Survolez pour agrandir' : 'Hover to expand';
---
<section class="section section--alt gallery" id="galerie">
  <div class="container">
    <header class="g-head" data-reveal>
      <p class="eyebrow">{eyebrow}</p>
      <h2>{g.title}</h2>
      <p class="g-intro">{g.intro}</p>
    </header>

    <div class="accordion" data-reveal>
      {g.images.map((img) => (
        <figure class="panel">
          <img src={img.src} alt={img.alt} loading="lazy" />
          <figcaption class="p-cap">{img.alt}</figcaption>
        </figure>
      ))}
    </div>
    <p class="g-hint">{hint}</p>
  </div>
</section>

<style>
  .g-head { text-align: center; max-width: 52ch; margin: 0 auto var(--s-4); }
  .g-head .eyebrow { justify-content: center; }
  .g-head h2 { max-width: none; }
  .g-intro { color: var(--ink-soft); font-size: var(--t-lead); margin: 0.4rem 0 0; }

  /* hover-expand accordion */
  .accordion {
    display: flex; gap: 0.55rem;
    height: clamp(360px, 56vh, 560px);
  }
  .panel {
    position: relative; flex: 1 1 0; min-width: 0; margin: 0;
    border-radius: var(--radius-lg); overflow: hidden;
    background: var(--tint);
    transition: flex-grow 0.6s var(--ease);
  }
  .panel img {
    position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.6s var(--ease);
  }

  /* one open by default; hovered one opens, the rest shrink */
  .panel:first-child { flex-grow: 4; }
  .accordion:hover .panel { flex-grow: 0.7; }
  .accordion .panel:hover { flex-grow: 4; }
  .accordion .panel:hover img { transform: scale(1.03); }

  .p-cap {
    position: absolute; left: 0; right: 0; bottom: 0; z-index: 1;
    padding: 2.2rem 1.25rem 1.1rem; white-space: nowrap;
    font-family: var(--serif-display); font-style: italic; font-size: 1.3rem; color: #fbf7ec;
    text-align: left;
    background: linear-gradient(to top, rgba(15, 30, 25, 0.78), transparent);
    opacity: 0; transition: opacity 0.4s var(--ease);
  }
  .panel:first-child .p-cap { opacity: 1; }
  .accordion:hover .panel .p-cap { opacity: 0; }
  .accordion .panel:hover .p-cap { opacity: 1; }

  .g-hint {
    text-align: center; margin: var(--s-3) 0 0;
    font-family: var(--ui); font-size: 0.72rem; letter-spacing: 0.22em; text-transform: uppercase;
    color: var(--sage-deep);
  }

  /* touch / small screens: a simple stacked gallery, no hover needed */
  @media (max-width: 760px) {
    .accordion { flex-direction: column; height: auto; gap: var(--s-2); }
    .panel { flex: none; height: 62vw; }
    .panel:first-child { flex-grow: 0; }
    .p-cap, .panel:first-child .p-cap { opacity: 1; font-size: 1.15rem; }
    .g-hint { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .panel, .panel img, .p-cap { transition: none; }
  }
</style>
