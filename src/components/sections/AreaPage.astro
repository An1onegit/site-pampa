---
import Section from '../Section.astro';
import { useTranslations } from '../../i18n/utils';
import type { Locale } from '../../i18n/routes';
interface Props { locale: Locale; kind: 'eat' | 'shop' | 'do'; }
const { locale, kind } = Astro.props;
const t = useTranslations(locale);
const a = t.area;
const title = a.tabs[kind];
const groups = kind === 'shop' ? a.shop : a.do;
const mapUrl = (query: string) =>
  `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(query)}`;
const mapLabel = locale === 'fr' ? 'Voir sur la carte' : 'View on map';
---
<Section eyebrow={t.meta.locationLine} title={title} level={1}>
  {kind === 'eat' ? (
    <div class="eat-grid">
      {a.eat.map((e) => (
        <article class="eat" data-reveal>
          <h3>{e.name}</h3>
          <p>{e.text}</p>
          <a class="addr" href={mapUrl(`${e.name}, ${e.address}`)} target="_blank" rel="noopener noreferrer" aria-label={`${mapLabel} : ${e.name}`}>
            {e.address}<span class="pin" aria-hidden="true">↗</span>
          </a>
        </article>
      ))}
    </div>
  ) : (
    <div class="groups">
      {groups.map((g) => (
        <div class="group" data-reveal>
          <h3>{g.groupTitle}</h3>
          <ul>{g.items.map((i) => <li>{i}</li>)}</ul>
        </div>
      ))}
    </div>
  )}
</Section>

<style>
  .eat-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(18rem, 1fr)); gap: var(--s-4); }
  .eat h3 { margin-bottom: 0.3rem; }
  .eat p { color: var(--ink-soft); margin: 0 0 0.35rem; }
  .eat .addr {
    display: inline-flex; align-items: baseline; gap: 0.35em;
    color: var(--sage-deep); font-style: italic; font-family: var(--serif-display);
    font-size: 1.05rem; margin: 0; text-decoration: none;
    border-bottom: 1px solid transparent; transition: color 0.2s, border-color 0.2s;
  }
  .eat .addr:hover { color: var(--pine); border-bottom-color: var(--wheat); }
  .eat .addr .pin { font-style: normal; font-size: 0.8em; color: var(--wheat); }

  .groups { display: grid; grid-template-columns: repeat(auto-fit, minmax(20rem, 1fr)); gap: var(--s-4) var(--s-5); }
  .group h3 { margin-bottom: 0.6rem; }
  .group ul { margin: 0; padding-left: 1.1rem; }
  .group li { margin-bottom: 0.45rem; max-width: var(--measure); color: var(--ink-soft); }
</style>
