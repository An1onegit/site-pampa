---
interface Props {
  title?: string;
  eyebrow?: string;
  id?: string;
  level?: 1 | 2;
  variant?: 'alt' | 'tint' | 'pine';
}
const { title, eyebrow, id, level = 2, variant } = Astro.props;
const Heading = level === 1 ? 'h1' : 'h2';
const cls = ['section', variant ? `section--${variant}` : ''].filter(Boolean).join(' ');
---
<section class={cls} id={id}>
  <div class="container">
    {(eyebrow || title) && (
      <header class="section-head" data-reveal>
        {eyebrow && <p class="eyebrow">{eyebrow}</p>}
        {title && <Heading class="section-title">{title}</Heading>}
      </header>
    )}
    <slot />
  </div>
</section>
<style>
  /* Keep a consistent visual size whether the title is an h1 or h2. */
  .section-title { font-size: var(--t-h2); max-width: 16ch; }
  .section-head { margin-bottom: var(--s-4); }
</style>
